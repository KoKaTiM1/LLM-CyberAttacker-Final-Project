# Inference mode: "local" uses Ollama, "remote" uses the cluster llama.cpp API.
INFERENCE_BACKEND=local
# Optional automatic fallback if the selected backend is unavailable.
# Leave empty to disable fallback.
FALLBACK_INFERENCE_BACKEND=

# Local Ollama settings.
LOCAL_OLLAMA_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=huihui_ai/deepseek-r1-abliterated:14b-qwen-distill
LOCAL_RAG_LLM_MODEL=llama3.2:1b

# Remote llama.cpp settings.
# For raw llama.cpp server mode this is usually the /completion endpoint.
# For llama-server OpenAI-compatible mode use /v1/chat/completions and set
# REMOTE_LLAMACPP_API_STYLE=openai.
REMOTE_LLAMACPP_URL=http://cluster-host:8080/completion
REMOTE_LLAMACPP_API_STYLE=raw
REMOTE_LLM_MODEL=cluster-model-name
REMOTE_RAG_LLM_MODEL=cluster-model-name
REMOTE_LLAMACPP_API_KEY=

# Runtime timeouts.
OLLAMA_TIMEOUT_SECONDS=600
REMOTE_LLAMACPP_TIMEOUT_SECONDS=600
SANDBOX_COMMAND_TIMEOUT_SECONDS=900
